---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
const kinds = ['Website', 'Web-App', 'Visitenkarten oder Flyer', 'Betreuung', 'Weiß ich noch nicht'];
---
<Base title="Kontakt" description="Kontakt zu Simon Sporer: Telefon, E-Mail oder WhatsApp. Das erste Gespräch ist kostenlos.">
  <PageHead title="Kontakt" intro="Am schnellsten geht es per Telefon oder WhatsApp. Wenn Sie lieber schreiben, nutzen Sie das Formular. Das erste Gespräch kostet nichts." />

  <section class="wrap grid">
    <div class="direct">
      <a class="big" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      <a class="big" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn btn-line" href={`https://wa.me/${site.whatsapp}`} rel="noopener">Per WhatsApp schreiben</a>
      <p class="muted">{site.owner}<br />{site.street}, {site.zip} {site.city}<br />Termine vor Ort in {site.city} und Umgebung, sonst per Telefon oder Video.</p>
      <p class="free"><span class="led" aria-hidden="true"></span>{site.availability}</p>
    </div>

    <form class="form" data-contact novalidate>
      <fieldset>
        <legend>Worum geht es?</legend>
        <div class="chips">
          {kinds.map((k) => <label class="pick"><input type="checkbox" name="art" value={k} /><span>{k}</span></label>)}
        </div>
      </fieldset>
      <label class="field"><span>Ihr Name</span><input name="name" autocomplete="name" required /></label>
      <label class="field"><span>Betrieb oder Verein (falls vorhanden)</span><input name="firma" autocomplete="organization" /></label>
      <label class="field"><span>Telefon oder E-Mail für die Antwort</span><input name="kontakt" autocomplete="email" required /></label>
      <label class="field"><span>Was haben Sie vor?</span><textarea name="nachricht" rows="6" required placeholder="Zum Beispiel: Wir sind ein Malerbetrieb mit fünf Leuten und haben noch keine Website …"></textarea></label>
      <p class="err" role="alert" hidden>Bitte Name, Kontakt und eine kurze Nachricht ausfüllen.</p>
      <div class="send">
        <button type="submit" value="whatsapp" class="btn btn-ink">Als WhatsApp senden</button>
        <button type="submit" value="mail" class="btn btn-line">Als E-Mail senden</button>
      </div>
      <p class="muted small">Das Formular speichert nichts. Es setzt nur Ihre Nachricht zusammen und öffnet sie in WhatsApp oder Ihrem Mailprogramm, wo Sie sie selbst abschicken.</p>
    </form>
  </section>
  <div style="height:clamp(64px,8vw,120px)"></div>
</Base>

<style>
  .grid { display: grid; gap: 56px 80px; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1fr 1.3fr; } .direct { position: sticky; top: 24px; align-self: start; } }
  .direct { display: grid; gap: 14px; justify-items: start; }
  .big { font-family: var(--serif); font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem); line-height: 1.15; overflow-wrap: anywhere; text-decoration-thickness: 2px; }
  .direct .btn { margin: 8px 0 10px; }
  .free { display: flex; align-items: center; gap: 10px; font-weight: 500; }
  .led { width: 9px; height: 9px; border-radius: 50%; background: #5f8a4a; box-shadow: 0 0 0 3px rgb(95 138 74 / .18); }

  .form { display: grid; gap: 22px; background: var(--sand); border-radius: var(--r-box); padding: clamp(22px, 4vw, 40px); }
  fieldset { border: 0; padding: 0; }
  legend, .field > span { font-weight: 600; font-size: .95rem; margin-bottom: 10px; display: block; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .pick input { position: absolute; opacity: 0; }
  .pick span { display: inline-block; padding: 9px 14px; border: 1.5px solid var(--taupe); border-radius: var(--r-ui); cursor: pointer; font-size: .95rem; background: var(--paper); }
  .pick input:checked + span { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .pick input:focus-visible + span { outline: 2px solid var(--pen); outline-offset: 2px; }
  .field { display: grid; }
  .field input, .field textarea { width: 100%; padding: 12px 14px; border: 1.5px solid var(--taupe); border-radius: var(--r-ui); background: var(--paper); resize: vertical; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--ink); }
  .field.invalid input, .field.invalid textarea { border-color: #b0442f; }
  .err { color: #b0442f; font-weight: 500; }
  .send { display: flex; flex-wrap: wrap; gap: 10px; }
  .small { font-size: .88rem; }
</style>

<script>
  import { site } from '../data/site';
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  if (form) {
    const pre = new URLSearchParams(location.search).get('thema');
    if (pre) form.querySelectorAll<HTMLInputElement>('input[name="art"]').forEach((i) => { if (i.value === pre) i.checked = true; });
    const err = form.querySelector<HTMLElement>('.err')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const via = ((e as SubmitEvent).submitter as HTMLButtonElement | null)?.value ?? 'whatsapp';
      const fd = new FormData(form);
      let first: HTMLElement | null = null;
      for (const n of ['name', 'kontakt', 'nachricht']) {
        const el = form.querySelector<HTMLInputElement>(`[name="${n}"]`)!;
        const bad = !String(fd.get(n) ?? '').trim();
        el.closest('.field')!.classList.toggle('invalid', bad);
        if (bad && !first) first = el;
      }
      err.hidden = !first;
      if (first) { first.focus(); return; }
      const art = fd.getAll('art').join(', ');
      const text = [
        'Hallo Simon,', '',
        String(fd.get('nachricht')).trim(), '',
        art ? `Es geht um: ${art}` : null,
        `${fd.get('name')}${fd.get('firma') ? `, ${fd.get('firma')}` : ''}`,
        String(fd.get('kontakt')),
      ].filter((l) => l !== null).join('\n');
      if (via === 'mail') location.href = `mailto:${site.email}?subject=${encodeURIComponent('Anfrage über die Website')}&body=${encodeURIComponent(text)}`;
      else window.open(`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  }
</script>
