---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Steps from '../components/Steps.astro';
import ContactBand from '../components/ContactBand.astro';
import { services, prices } from '../data/content';
const price = (item: string) => prices.find((p) => p.item.startsWith(item))!.price;
const priceFor: Record<string, string> = { websites: price('Website mit einer'), 'web-apps': price('Web-App'), drucksachen: price('Visitenkarten'), betreuung: price('Hosting') };
---
<Base title="Leistungen" description="Websites, Web-Apps, Drucksachen und Betreuung aus einer Hand, von Simon Sporer aus Stuttgart.">
  <PageHead title="Leistungen" intro="Ich mache alles selbst, von der Gestaltung über die Programmierung bis zur Betreuung danach. Sie haben einen Ansprechpartner, und nichts geht zwischen zwei Firmen verloren." />

  <div class="wrap">
    {services.map((s) => (
      <section class="svc" id={s.slug}>
        <div class="left">
          <h2>{s.title}</h2>
          <p class="muted for">Passt für: {s.for}</p>
          <p class="price">{priceFor[s.slug]}</p>
        </div>
        <div class="right">
          <p class="intro-text">{s.text}</p>
          <h3 class="inc-h">Das ist dabei</h3>
          <ul class="inc">{s.includes.map((i) => <li>{i}</li>)}</ul>
        </div>
      </section>
    ))}
  </div>

  <section class="wrap block">
    <h2 class="steps-h">So läuft ein Projekt ab</h2>
    <Steps />
  </section>

  <ContactBand />
</Base>

<style>
  .svc { display: grid; gap: 24px 64px; padding-block: clamp(44px, 6vw, 80px); border-top: 1.5px solid var(--ink); scroll-margin-top: 20px; }
  @media (min-width: 900px) { .svc { grid-template-columns: 1fr 2fr; } }
  .left { display: grid; gap: 12px; align-content: start; }
  .for { font-size: .95rem; }
  .price { font-weight: 650; }
  .inc-h { font-family: var(--sans); font-size: 1rem; font-weight: 650; margin: 28px 0 8px; }
  .inc { padding-left: 1.1em; display: grid; gap: 6px; }
  .inc li::marker { color: var(--taupe); }
  .steps-h { margin-bottom: 28px; }
</style>
