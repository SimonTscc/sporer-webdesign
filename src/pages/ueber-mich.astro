---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ContactBand from '../components/ContactBand.astro';
import { site, isPreview } from '../data/site';

// [SWAP] Was gerade in Arbeit ist, ab und zu aktualisieren
const now = [
  'Flame n Go nach dem Umzug von Wix weiter betreuen',
  'Die Vereinsmeisterschafts-App für das nächste Schießjahr vorbereiten',
  'Pauls Coaching-Seite fertig machen, sobald er sich für einen Entwurf entschieden hat',
];
---
<Base title="Über mich" description={`${site.owner} aus ${site.city}: Websites und Web-Apps für kleine Betriebe und Vereine.`}>
  <PageHead title="Über mich" />

  <section class="wrap grid">
    <figure class="photo">
      <!-- [SWAP] Echtes Foto einsetzen: Datei nach src/assets/simon.jpg legen und hier mit <Image> einbinden -->
      <div class="ph"><span class="hand">Foto folgt</span></div>
      <figcaption class="muted">{site.owner}, {site.city}</figcaption>
    </figure>
    <div class="text">
      <p class="intro-text">Ich heiße Simon Sporer und baue Websites und Web-Apps für Betriebe, Selbstständige und Vereine aus Stuttgart und Umgebung.</p>
      <p>
        {site.name} ist mein Kleingewerbe in {site.city}. Ich arbeite allein, und das ist Absicht: Wer mich anruft, spricht mit der Person,
        die auch die Seite baut. Ich gestalte, programmiere und betreue alles selbst.
      </p>
      <p>
        Ich mag Seiten, die schnell laden, auf dem Handy gut funktionieren und nach dem Betrieb aussehen, für den sie gemacht sind,
        nicht nach einer Vorlage. Dafür nehme ich mir lieber ein paar Projekte weniger vor und mache die dafür ordentlich.
      </p>
      {isPreview && <p class="muted small">[SWAP] Ein, zwei Sätze Persönliches ergänzen: Ausbildung, wie es angefangen hat, was du außerhalb der Arbeit machst.</p>}

      <h2 class="now-h">Gerade auf dem Tisch</h2>
      <ul class="now">{now.map((n) => <li>{n}</li>)}</ul>
    </div>
  </section>

  <div class="block"></div>
  <ContactBand title="Lernen wir uns kennen." />
</Base>

<style>
  .grid { display: grid; gap: 48px 72px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1.5fr; } }
  .photo { margin: 0; display: grid; gap: 10px; align-content: start; }
  .ph { aspect-ratio: 4 / 5; background: var(--sand); border-radius: var(--r-box); display: grid; place-items: center; }
  .ph .hand { font-size: 2.4rem; transform: rotate(-4deg); }
  figcaption { font-size: .92rem; }
  .text { display: grid; gap: 0; align-content: start; }
  .small { font-size: .9rem; margin-top: 1em; }
  .now-h { font-size: 1.6rem; margin: 48px 0 14px; }
  .now { list-style: none; padding: 0; border-top: 1.5px solid var(--ink); }
  .now li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .block { padding-block: clamp(30px, 5vw, 60px); }
</style>
