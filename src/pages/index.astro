---
// One-Pager: Karte → Aufmaß (einziger Weg, eine Anfrage zu schicken) → Arbeiten → Ablauf → Fragen → direkt reden
import Base from '../layouts/Base.astro';
import Karte from '../components/Karte.astro';
import Aufmass from '../components/Aufmass.astro';
import ProjectRows from '../components/ProjectRows.astro';
import Steps from '../components/Steps.astro';
import { faq } from '../data/content';
import { site } from '../data/site';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base home>
  <Karte />

  <Aufmass />

  <section class="wrap block work" id="arbeiten">
    <div class="sec-head">
      <h2>Was schon fertig ist</h2>
      <p class="muted">Alle diese Seiten habe ich 2026 gestaltet und programmiert, ohne Baukasten und ohne Vorlage. Die Bilder zeigen jeweils die ganze Seite. Fahren Sie mit der Maus darüber oder scrollen Sie auf dem Handy darin.</p>
    </div>
    <ProjectRows />
  </section>

  <section class="wrap two" id="ablauf">
    <div>
      <h2>Wie es weitergeht</h2>
      <Steps />
    </div>
    <div class="me">
      <h2>Wer das baut</h2>
      <p>Ich heiße Simon Sporer und mache das allein, ohne Agentur dahinter. Sie reden also immer mit dem, der die Seite auch baut.</p>
      <p>Ich nutze keine Baukästen und keine gekauften Vorlagen. Jede Seite wird neu gestaltet, lädt schnell und gehört danach Ihnen, mit dem ganzen Code.</p>
    </div>
  </section>

  <section class="wrap faq-wrap" id="fragen">
    <h2>Häufige Fragen</h2>
    <dl class="faq">
      {faq.map((f) => (
        <div>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap talk">
    <div class="rule"><i></i></div>
    <div class="talk-in">
      <div>
        <h2>Lieber erst reden?</h2>
        <p class="muted">Rufen Sie an oder schreiben Sie mir bei WhatsApp. Das erste Gespräch ist kostenlos.</p>
      </div>
      <div class="ways">
        <a class="phone" href={`tel:${site.phoneHref}`}>{site.phone}</a>
        <div class="btns">
          <a class="btn btn-ink" href={`https://wa.me/${site.whatsapp}`} rel="noopener">WhatsApp</a>
          <a class="btn btn-line" href="#aufmass">Doch lieber das Aufmaß</a>
        </div>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>

<style>
  .work { padding-top: 0; }
  .sec-head { display: grid; gap: 14px 64px; margin-bottom: 36px; align-items: end; }
  @media (min-width: 900px) { .sec-head { grid-template-columns: 1fr 1.3fr; } }
  .sec-head p { max-width: 36em; }
  .two { display: grid; gap: 56px 80px; padding-bottom: clamp(72px, 9vw, 120px); }
  @media (min-width: 900px) { .two { grid-template-columns: 1.1fr 1fr; } }
  .two h2, .faq-wrap h2 { font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.5rem); margin-bottom: 22px; }
  .me p { max-width: 34em; }

  .faq-wrap { padding-bottom: clamp(72px, 9vw, 120px); }
  .faq { border-top: 1px solid var(--line); }
  .faq > div { display: grid; gap: 8px 64px; padding-block: 22px; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .faq > div { grid-template-columns: 1fr 1.6fr; } }
  dt { font-family: var(--serif); font-size: clamp(1.2rem, 1.1rem + .4vw, 1.45rem); line-height: 1.25; }
  dd { margin: 0; max-width: 38em; }

  .talk { padding-bottom: clamp(72px, 9vw, 120px); }
  .talk-in { display: grid; gap: 28px 64px; margin-top: clamp(48px, 6vw, 80px); align-items: end; }
  @media (min-width: 900px) { .talk-in { grid-template-columns: 1fr 1fr; } }
  .talk h2 { margin-bottom: 10px; }
  .ways { display: grid; gap: 16px; justify-items: start; }
  .phone { font-family: var(--serif); font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.5rem); text-decoration: none; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
