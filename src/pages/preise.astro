---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PriceList from '../components/PriceList.astro';
import ContactBand from '../components/ContactBand.astro';
import Aufmass from '../components/Aufmass.astro';
import { site } from '../data/site';
---
<Base title="Preise" description="Preise von Sporer Webdesign: Website mit einer Seite ab 490 €, mit mehreren Seiten ab 890 €, Web-Apps ab 1.190 €. Festpreis nach dem Erstgespräch.">
  <PageHead title="Preise" intro="Nach dem ersten Gespräch bekommen Sie ein Angebot mit Festpreis. Die Zahlen hier sind Richtwerte, damit Sie vorher wissen, woran Sie sind." />

  <section class="wrap grid">
    <div class="list">
      <PriceList />
      <p class="hand note">alles Endpreise</p>
    </div>
    <aside class="info">
      <h2>Gut zu wissen</h2>
      <ul>
        <li>{site.taxNote}</li>
        <li>Bezahlt wird in zwei Teilen: die Hälfte zum Start, den Rest, wenn die Seite online ist.</li>
        <li>Domain und Hosting sind in der Betreuung enthalten. Wer das selbst machen will, kann das auch.</li>
        <li>Texte und Fotos liefern Sie, ich helfe beim Formulieren und Auswählen.</li>
        <li>Die Seite gehört Ihnen. Wenn Sie irgendwann woanders hinwollen, bekommen Sie alle Dateien.</li>
      </ul>
    </aside>
  </section>

  <Aufmass title="Oder rechnen Sie es selbst aus." intro="Stellen Sie zusammen, was Sie brauchen. Die Skizze zeichnet mit, und Ihre Auswahl können Sie mir direkt schicken." />

  <section class="wrap block" style="padding-top:0">
    <h2 class="ex-h">Zwei Beispiele</h2>
    <div class="ex">
      <div>
        <h3>Friseursalon, eine Seite</h3>
        <p>Leistungen und Preise, Öffnungszeiten, Anfahrt, Online-Termin über WhatsApp, Impressum und Datenschutz. Dazu ein Jahr Betreuung.</p>
        <p class="sum">490 € + 12 × 15 €</p>
      </div>
      <div>
        <h3>Handwerksbetrieb, fünf Seiten</h3>
        <p>Start, Leistungen, Referenzen mit Fotos, Über uns, Kontakt. Dazu Visitenkarten und Flyer als Druckdatei.</p>
        <p class="sum">890 € + 69 €</p>
      </div>
    </div>
  </section>

  <ContactBand title="Lieber erst reden?" />
</Base>

<style>
  .grid { display: grid; gap: 48px 72px; padding-bottom: clamp(40px, 6vw, 80px); }
  @media (min-width: 960px) { .grid { grid-template-columns: 1.6fr 1fr; } }
  .list { border-top: 1.5px solid var(--ink); padding-top: 8px; }
  .note { margin-top: 18px; transform: rotate(-2deg); display: inline-block; }
  .info { background: var(--sand); border-radius: var(--r-box); padding: 28px 30px; align-self: start; }
  .info h2 { font-size: 1.5rem; margin-bottom: 14px; }
  .info ul { padding-left: 1.1em; display: grid; gap: 10px; font-size: .97rem; }
  .info li::marker { color: var(--taupe); }
  .ex-h { margin-bottom: 28px; }
  .ex { display: grid; gap: 24px; }
  @media (min-width: 800px) { .ex { grid-template-columns: 1fr 1fr; } }
  .ex > div { border-top: 1.5px solid var(--ink); padding-top: 22px; display: grid; gap: 10px; align-content: start; }
  .sum { font-weight: 650; }
</style>
