---
import Base from '../layouts/Base.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<Base title={title}>
  <article class="wrap legal">
    <h1>{title}</h1>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .legal { max-width: calc(44em + var(--pad) * 2); padding-block: clamp(40px, 7vw, 96px) clamp(64px, 8vw, 110px); }
  .prose { margin-top: 28px; }
  .prose :global(h2) { font-size: 1.45rem; margin: 40px 0 10px; }
  .prose :global(h3) { font-family: var(--sans); font-size: 1rem; font-weight: 650; margin: 22px 0 6px; }
  .prose :global(.todo) { background: var(--sand); border-left: 3px solid var(--pen); padding: 12px 16px; font-size: .92rem; }
</style>
