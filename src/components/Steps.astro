---
import { steps } from '../data/content';
---
<ol class="steps">
  {steps.map((s) => <li><p>{s.text}</p><span class="dur">{s.time}</span></li>)}
</ol>

<style>
  .steps { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  li { display: grid; gap: 4px 32px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 700px) { li { grid-template-columns: 1fr 180px; } }
  .dur { color: var(--ink-2); font-size: .93rem; }
  @media (min-width: 700px) { .dur { text-align: right; } }
</style>
