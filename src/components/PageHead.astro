---
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---
<section class="wrap head">
  <h1>{title}</h1>
  {intro && <p class="intro-text">{intro}</p>}
  <slot />
</section>

<style>
  .head { padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(40px, 5vw, 64px); display: grid; gap: 22px; }
  h1 { max-width: 16ch; }
  .intro-text { max-width: 34em; color: var(--ink-2); }
</style>
