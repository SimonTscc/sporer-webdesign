---
// Projekte als Zeilen. Der Screenshot ist die ganze Seite: mit der Maus darüber scrollt er langsam durch.
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
---
<ul class="rows">
  {projects.map((p) => (
    <li class="row">
      <div class:list={['shot', { phones: p.mobile }]}>
        {p.mobile
          ? p.images.map((img) => <Image src={img} alt="" widths={[260, 520]} sizes="200px" />)
          : <Image src={p.images[0]} alt="" widths={[640, 1100]} sizes="(min-width: 900px) 640px, 92vw" />}
      </div>
      <div class="txt">
        <h3>{p.client}</h3>
        <p class="kind">{p.kind} · {p.place} · {p.year}</p>
        <p>{p.summary}</p>
        {p.url && <p class="live">Online unter <a href={p.url} rel="noopener">{p.url.replace(/^https?:\/\/(www\.)?/, '')}</a></p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .rows { list-style: none; padding: 0; }
  .row { display: grid; gap: 22px 48px; padding-block: 36px; border-top: 1px solid var(--line); align-items: center; }
  .row:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .row { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); } }
  .shot { --h: 360px; display: block; height: var(--h); overflow: hidden; background: var(--sand); border-radius: var(--r-paper); box-shadow: 0 0 0 1.5px var(--ink); }
  .shot :global(img) { width: 100%; transition: transform 4.5s cubic-bezier(.4, .1, .3, 1); }
  .shot:hover :global(img) { transform: translateY(calc(-100% + var(--h))); }
  .shot.phones { display: flex; gap: 16px; justify-content: center; padding: 24px; }
  .shot.phones :global(img) { width: auto; height: 100%; border-radius: 14px; box-shadow: 0 0 0 1.5px var(--ink); transition: none; transform: none; }
  @media (max-width: 899px) { .shot { --h: 280px; } }
  @media (hover: none) { .shot:not(.phones) { overflow-y: auto; overscroll-behavior: contain; } .shot:hover :global(img) { transform: none; } }
  .kind { color: var(--ink-2); font-size: .93rem; margin: 4px 0 12px; }
  .txt p:not(.kind) { max-width: 34em; }
  .live { font-size: .95rem; color: var(--ink-2); }
</style>
