---
// Preisliste mit Punktlinien wie auf einer Karte im Laden
import { prices } from '../data/content';
interface Props { limit?: number }
const { limit } = Astro.props;
const list = limit ? prices.slice(0, limit) : prices;
---
<dl class="prices">
  {list.map((p) => (
    <div class="row">
      <dt><span class="item">{p.item}</span><span class="note">{p.note}</span></dt>
      <dd>{p.price}</dd>
    </div>
  ))}
</dl>

<style>
  .prices { display: grid; gap: 4px; }
  .row { display: flex; align-items: baseline; gap: 12px; padding-block: 12px; }
  .row::after { content: ''; order: 1; flex: 1; min-width: 24px; border-bottom: 2px dotted var(--taupe); transform: translateY(-6px); }
  dt { order: 0; display: grid; }
  .item { font-family: var(--serif); font-size: clamp(1.15rem, 1.05rem + .4vw, 1.4rem); line-height: 1.2; }
  .note { font-size: .88rem; color: var(--ink-2); }
  dd { order: 2; margin: 0; font-weight: 650; white-space: nowrap; }
</style>
