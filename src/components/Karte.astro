---
import { href } from '../lib/url';
// Startseite: Die Visitenkarte liegt auf dem Tisch und klappt beim Scrollen auf wie ein Leporello.
// Desktop: seitlich (rotateY), Handy: senkrecht (rotateX). Ohne JavaScript oder bei „weniger Bewegung“
// liegen die drei Felder einfach offen nebeneinander bzw. untereinander.
import Logo from './Logo.astro';
import { site } from '../data/site';
import { prices } from '../data/content';
const price = (item: string) => prices.find((p) => p.item.startsWith(item))!.price;
const short = [
  ['Website, eine Seite', price('Website mit einer')],
  ['Website, mehrere Seiten', price('Website mit mehreren')],
  ['Web-App', price('Web-App')],
  ['Visitenkarten, Flyer', price('Visitenkarten')],
  ['Betreuung', price('Hosting')],
];
---
<section class="stage" id="karte" aria-label="Visitenkarte von Simon Sporer"
  data-name={site.owner} data-org={site.name} data-tel={site.phoneHref} data-mail={site.email} data-url={site.url} data-city={site.city}>
  <div class="pin">
    <p class="intro" id="kIntro">Scrollen zum Aufklappen</p>
    <div class="lep" id="kLep">
      <div class="panel p2">
        <div class="face inside2">
          <h2>Was ich für Sie baue</h2>
          <ul>
            <li><b>Websites</b> <span>für Betriebe, Praxen, Studios und Coaches</span></li>
            <li><b>Web-Apps</b> <span>mit Login, z. B. für Vereine und Anmeldungen</span></li>
            <li><b>Drucksachen</b> <span>Visitenkarten und Flyer passend zur Website</span></li>
            <li><b>Betreuung</b> <span>Domain, Hosting, kleine Änderungen</span></li>
          </ul>
        </div>
      </div>
      <div class="panel p3" id="kP3">
        <div class="face inside3">
          <h2>Was es ungefähr kostet</h2>
          <ul>{short.map(([a, b]) => <li><span>{a}</span><span>{b}</span></li>)}</ul>
          <p><a href="#aufmass">Selbst zusammenstellen</a></p>
        </div>
        <div class="face back blank" aria-hidden="true"></div>
      </div>
      <div class="panel p1" id="kP1">
        <div class="face inside1">
          <div><p class="nm">{site.owner}</p><p class="who">Webdesign aus {site.city}</p></div>
          <div>{site.phone && <a class="l" href={`tel:${site.phoneHref}`}>{site.phone}</a>}<a class="l" href={`mailto:${site.email}`}>{site.email}</a><a class="l" href="#aufmass">Anfrage über das Aufmaß</a></div>
          <div class="acts"><button class="mini" id="kVcf" type="button">Kontakt speichern</button>{site.whatsapp && <a class="mini o" href={`https://wa.me/${site.whatsapp}`} rel="noopener">WhatsApp</a>}</div>
        </div>
        <div class="face back cover" aria-hidden="true">
          <Logo withCity />
          <div class="coords"><span>48.7758° N</span><span>9.1829° E</span></div>
        </div>
      </div>
    </div>
    <p class="hint" id="kHint" aria-hidden="true"><b></b></p>
  </div>
</section>

<style>
  .stage { position: relative; background: var(--sand); }
  :global(.js) .stage { height: 330vh; }
  .pin { position: sticky; top: 0; height: 100vh; height: 100svh; display: grid; place-items: center; overflow: hidden; perspective: 2200px; }
  .intro { position: absolute; top: 9vh; left: 0; right: 0; padding: 0 24px; text-align: center; font-family: var(--serif); font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); transition: opacity .3s; }
  .intro { font-size: clamp(1.8rem, 1.3rem + 2vw, 2.8rem); font-weight: 300; }
  .hint { position: absolute; bottom: 26px; left: 0; right: 0; display: grid; justify-items: center; gap: 8px; color: var(--ink); font-size: 1rem; font-weight: 500; transition: opacity .3s; }
  .hint span { background: var(--paper); padding: 8px 14px; border-radius: var(--r-ui); box-shadow: 0 0 0 1px var(--line); }
  /* Linie mit Punkt fällt nach unten: Leitmotiv als Scroll-Zeichen */
  .hint b { position: relative; width: 1.5px; height: 56px; background: var(--taupe); }
  .hint b::after { content: ''; position: absolute; left: 50%; top: 0; width: 9px; height: 9px; margin-left: -4.5px; border-radius: 50%; background: var(--ink); animation: fall 1.6s cubic-bezier(.5, 0, .5, 1) infinite; }
  @keyframes fall { 0% { transform: translateY(0); opacity: 0; } 20% { opacity: 1; } 80% { opacity: 1; } 100% { transform: translateY(38px); opacity: 0; } }

  /* Alle Maße in em: Das Skript setzt die Schriftgröße nur bei Größenänderung auf die größte Stufe und skaliert beim Scrollen herunter.
     So bleibt die Karte scharf und Safari muss beim Scrollen kein Layout neu berechnen. */
  .lep { --W: 26.25em; --H: 17em; font-size: 16px; position: relative; width: var(--W); height: var(--H); transform-style: preserve-3d; will-change: transform; }
  .panel { position: absolute; top: 0; left: 0; width: var(--W); height: var(--H); transform-style: preserve-3d; }
  .p1 { left: calc(var(--W) * -1); transform-origin: right center; }
  .p3 { left: var(--W); transform-origin: left center; }
  .face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; padding: 1.625em 1.75em; overflow: hidden; box-shadow: var(--shadow-paper); }
  .face.back { transform: rotateY(180deg); }
  .blank { background: #e3d7c3; box-shadow: none; }

  .cover { background: var(--sand); display: grid; place-items: center; background-image: linear-gradient(rgb(255 255 255 / .2), rgb(0 0 0 / .02)); }
  .cover :global(svg) { width: 72%; }
  .coords { position: absolute; bottom: 1.4em; left: 2.4em; right: 2.4em; display: flex; justify-content: space-between; font-family: ui-monospace, Menlo, monospace; font-size: .625em; color: var(--taupe); }

  .inside1 { background: var(--ink); color: var(--paper); display: flex; flex-direction: column; justify-content: space-between; }
  .nm { font-family: var(--serif); font-weight: 300; font-size: 1.875em; line-height: 1.1; }
  .who { color: var(--beige); font-size: .8125em; margin-top: .15em; }
  .l { display: block; text-decoration: none; font-size: .97em; line-height: 1.55; }
  .acts { display: flex; gap: .5em; }
  .mini { display: inline-block; background: var(--beige); color: var(--ink); border: 0; border-radius: 2px; padding: .6em .9em; font-size: .8125em; font-weight: 500; cursor: pointer; text-decoration: none; }
  .mini.o { background: transparent; color: var(--paper); box-shadow: inset 0 0 0 1px var(--taupe); }
  .inside2 { background: var(--paper); }
  .inside3 { background: var(--sand-2); }
  .inside2 h2, .inside3 h2 { font-size: 1.375em; font-weight: 400; margin-bottom: .45em; }
  .inside2 ul, .inside3 ul { list-style: none; padding: 0; font-size: .84em; line-height: 1.45; }
  .inside2 li { padding: .37em 0; border-top: 1px solid var(--line); }
  .inside2 li b { font-weight: 500; }
  .inside2 li span { color: var(--ink-2); }
  .inside3 li { display: flex; justify-content: space-between; gap: .75em; padding: .37em 0; border-top: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .inside3 li span:last-child { white-space: nowrap; }
  .inside3 p { font-size: .8125em; margin-top: .6em; }

  /* Handy: Felder höher als das Kartenformat, damit die Schrift lesbar bleibt */
  @media (max-width: 820px) {
    .lep { --W: 20.625em; --H: 15em; }
    .p1 { left: 0; top: calc(var(--H) * -1); transform-origin: center bottom; }
    .p3 { left: 0; top: var(--H); transform-origin: center top; }
    .face.back { transform: rotateX(180deg); }
    .face { padding: 1.125em 1.25em; }
    .nm { font-size: 1.625em; }
    .inside2 h2, .inside3 h2 { font-size: 1.25em; margin-bottom: .3em; }
    .inside2 li, .inside3 li { padding: .3em 0; }
    .intro { top: auto; bottom: calc(50% + 150px); }
    .hint { bottom: 18px; font-size: .95rem; }
  }

  /* Ohne JavaScript oder mit „weniger Bewegung“: alles offen hinlegen */
  :global(.no-js) .pin, .stage.static .pin { position: relative; height: auto; display: block; perspective: none; padding: 40px var(--pad) 70px; }
  :global(.no-js) .lep, .stage.static .lep { width: auto; height: auto; display: grid; gap: 16px; max-width: 1300px; margin: 0 auto; transform: none !important; }
  @media (min-width: 821px) { :global(.no-js) .lep, .stage.static .lep { grid-template-columns: repeat(3, 1fr); } }
  :global(.no-js) .panel, .stage.static .panel { position: relative; left: auto; top: auto; width: auto; height: auto; aspect-ratio: 85 / 55; transform: none !important; opacity: 1 !important; order: 2; }
  :global(.no-js) .p1, .stage.static .p1 { order: 1; }
  :global(.no-js) .face.back, .stage.static .face.back { display: none; }
  :global(.no-js) .intro, :global(.no-js) .hint, .stage.static .intro, .stage.static .hint { display: none; }
</style>

<script>
  const stage = document.getElementById('karte')!;
  const lep = document.getElementById('kLep')!;
  const p1 = document.getElementById('kP1')!;
  const p3 = document.getElementById('kP3')!;
  const intro = document.getElementById('kIntro')!;
  const hint = document.getElementById('kHint')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = matchMedia('(min-width: 821px)');
  const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
  const ease = (t: number) => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  let prog = 0, target = 0, mx = 0, my = 0, queued = false, peek = 0, top = 0, base = 1, lastVw = 0, lastVh = 0, stageH = 0, stageTop = 0;
  let dims: ReturnType<typeof sizes>;
  const touch = matchMedia('(pointer: coarse)').matches;

  // Größen: nur bei Resize neu rechnen, nicht bei jedem Scroll-Frame
  function sizes() {
    const vert = !wide.matches;
    const W = vert ? 330 : 420, H = vert ? 240 : (W * 55) / 85;
    const vw = innerWidth, vh = innerHeight;
    const sClosed = vert ? Math.min((vw * .9) / W, 1.1) : Math.min(1.45, (vw * .58) / W, (vh * .44) / H);
    const sOpen = vert ? Math.min((vw * .92) / W, ((vh - 40) * .94) / (3 * H)) : Math.min(1.12, (vw * .92) / (3 * W), (vh * .7) / H);
    return { vert, W, H, sClosed, sOpen };
  }
  function layout() {
    const z = (dims = sizes());
    base = Math.max(z.sClosed, z.sOpen);
    lep.style.fontSize = `${(16 * base).toFixed(2)}px`;
    lastVw = innerWidth; lastVh = innerHeight;
    // Bühnenhöhe in festen Pixeln statt 330vh: In iOS-Safari ändert sich vh, wenn die Adressleiste
    // ein- und ausfährt. Dann wurde die Seite kürzer/länger, die Scrollposition rutschte und die Karte
    // klappte hin und her. So bleibt die Höhe stabil, bis sich die Fenstergröße wirklich ändert.
    stageH = Math.round(lastVh * 3.3);
    stage.style.height = `${stageH}px`;
    // Lage der Bühne im Dokument einmal messen; beim Scrollen zählt nur noch scrollY
    stageTop = stage.getBoundingClientRect().top + scrollY;
  }

  function render() {
    queued = false;
    // Weich zum Ziel nachziehen: Ein, zwei verirrte Werte (z. B. während Safari die Leiste umschaltet)
    // klappen die Karte so nicht mehr sichtbar zu
    prog += (target - prog) * .45;
    if (Math.abs(target - prog) < .0005) prog = target;
    else ask();
    const { vert, W, H, sClosed, sOpen } = dims;
    const kScroll = ease(clamp((prog - .08) / .32)); // Karte aufklappen
    const k1 = prog < .02 ? peek : kScroll;           // am Anfang lupft sich die Karte ein Stück
    const k2 = ease(clamp((prog - .42) / .32)); // dritte Seite ausklappen
    const ax = vert ? 'X' : 'Y', sg = vert ? -1 : 1;
    p1.style.transform = `translateZ(2px) rotate${ax}(${sg * (180 - 180 * k1)}deg)`;
    p3.style.transform = `translateZ(-2px) rotate${ax}(${sg * (-180 + 180 * k2)}deg)`;
    p3.style.opacity = k1 > .98 ? '1' : '0';
    const s = sClosed + (sOpen - sClosed) * ease(clamp((prog - .08) / .66));
    // sichtbare Mitte halten: zu nur die Karte, halb offen zwei Felder, ganz offen drei
    const shift = (vert ? H / 2 : W / 2) * (kScroll - k2);
    const tilt = vert ? 0 : 1 - k1 * .7;
    const move = vert ? `translateY(${(shift * s).toFixed(2)}px)` : `translateX(${(shift * s).toFixed(2)}px)`;
    lep.style.transform = `${move} scale(${(s / base).toFixed(4)}) rotateX(${my * 6 * tilt}deg) rotateY(${mx * 8 * tilt}deg)`;
    hint.style.opacity = prog > .8 ? '0' : '1';
    // ganz oben schiebt die Kopfzeile die Bühne nach unten: Hinweis trotzdem im Bild halten
    hint.style.transform = `translateY(${-Math.max(0, top)}px)`;
    intro.style.opacity = prog > .06 ? '0' : '1';
  }
  const ask = () => { if (!queued) { queued = true; requestAnimationFrame(render); } };

  if (still) stage.classList.add('static');
  else {
    // Fortschritt nur aus der Scrollposition der Seite und fest gemessenen Werten. Die Lage auf dem
    // Bildschirm (getBoundingClientRect) wackelt in iOS-Safari, während die Adressleiste umschaltet.
    const onScroll = () => {
      const y = scrollY;
      top = stageTop - y;
      target = clamp((y - stageTop) / (stageH - lastVh));
      ask();
    };
    // Handy/Tablet: nur beim Drehen neu layouten, Höhenänderungen kommen dort von der Adressleiste.
    // Desktop: auch bei deutlicher Höhenänderung des Fensters.
    const onResize = () => {
      if (innerWidth !== lastVw || (!touch && Math.abs(innerHeight - lastVh) > 120)) layout();
      onScroll();
    };
    layout();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onResize);
    addEventListener('pointermove', (e) => { if (e.pointerType !== 'mouse') return; mx = e.clientX / innerWidth - .5; my = -(e.clientY / innerHeight - .5); ask(); });
    onScroll();
    prog = target; // beim Laden nicht animiert hinziehen
    // Schriften und Bilder verschieben die Bühne beim Laden noch etwas: danach neu messen
    const remeasure = () => { stageTop = stage.getBoundingClientRect().top + scrollY; onScroll(); };
    document.fonts?.ready.then(remeasure);
    addEventListener('load', remeasure);
    // Alle 3 Sekunden hebt sich die Vorderseite kurz an, solange noch nicht gescrollt wurde
    const t0 = performance.now();
    const loop = (t: number) => {
      if (prog >= .02) { peek = 0; return; }
      const c = ((t - t0) % 3000) / 3000;
      peek = c < .35 ? Math.sin((c / .35) * Math.PI) * .09 : 0;
      render();
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  // Kontakt als vCard speichern
  document.getElementById('kVcf')!.addEventListener('click', () => {
    const d = stage.dataset;
    const [first, ...rest] = (d.name ?? '').split(' ');
    const v = ['BEGIN:VCARD', 'VERSION:3.0', `N:${rest.join(' ')};${first};;;`, `FN:${d.name}`, `ORG:${d.org}`, ...(d.tel ? [`TEL;TYPE=CELL:${d.tel}`] : []), `EMAIL:${d.mail}`, `URL:${d.url}`, `ADR;TYPE=WORK:;;;${d.city};;;Deutschland`, 'END:VCARD'].join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([v], { type: 'text/vcard' }));
    a.download = `${(d.name ?? 'Kontakt').replace(/\s+/g, '-')}.vcf`;
    a.click();
  });
</script>
